{
  "doctype": "DocType",
  "name": "Revenue Budget Change Request",
  "module": "Revenue Budget",
  "istable": 0,
  "editable_grid": 0,
  "is_submittable": 1,
  "track_changes": 1,
  "autoname": "format:RB-.YYYY.-.#####",
  "field_order": [
    "budget",
    "change_type",
    "reason",
    "request_status",
    "details",
    "new_exchange_rate",
    "result_budget",
    "impact_net_revenue"
  ],
  "fields": [
    {
      "fieldname": "budget",
      "fieldtype": "Link",
      "label": "Active Budget",
      "options": "Customer Revenue Budget",
      "reqd": 1
    },
    {
      "fieldname": "change_type",
      "fieldtype": "Select",
      "label": "Change Type",
      "options": "Price Change\nQuantity Change\nPrice and Quantity Change\nDiscount Change\nExchange Rate Change\nAdd Item\nRemove Item\nReplace Item\nCancel Budget",
      "reqd": 1
    },
    {
      "fieldname": "reason",
      "fieldtype": "Small Text",
      "label": "Reason",
      "reqd": 1
    },
    {
      "fieldname": "request_status",
      "fieldtype": "Select",
      "label": "Request Status",
      "options": "Draft\nApplied",
      "default": "Draft",
      "read_only": 1
    },
    {
      "fieldname": "details",
      "fieldtype": "Table",
      "label": "Changes",
      "options": "Revenue Budget Change Detail"
    },
    {
      "fieldname": "new_exchange_rate",
      "fieldtype": "Float",
      "label": "New Exchange Rate"
    },
    {
      "fieldname": "result_budget",
      "fieldtype": "Link",
      "label": "Result Version",
      "options": "Customer Revenue Budget",
      "read_only": 1
    },
    {
      "fieldname": "impact_net_revenue",
      "fieldtype": "Currency",
      "label": "Impact (Base)",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
